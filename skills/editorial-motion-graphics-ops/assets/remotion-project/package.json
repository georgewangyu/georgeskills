{
  "name": "__PROJECT_NAME__",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "poster": "remotion still src/index.ts EditorialMotion outputs/poster.png --frame=__POSTER_FRAME__",
    "frame:first": "remotion still src/index.ts EditorialMotion outputs/qa/first.png --frame=0",
    "frame:transformation": "remotion still src/index.ts EditorialMotion outputs/qa/transformation.png --frame=__TRANSFORMATION_FRAME__",
    "frame:final": "remotion still src/index.ts EditorialMotion outputs/qa/final.png --frame=__FINAL_FRAME__",
    "render:proof": "remotion render src/index.ts EditorialMotion outputs/proof.mp4 --scale=0.25 --codec=h264 --crf=22 --muted",
    "render:review": "remotion render src/index.ts EditorialMotion outputs/review.mp4 --codec=h264 --crf=20 --muted",
    "render:alpha": "remotion render src/index.ts EditorialMotion outputs/alpha.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png --muted"
  },
  "dependencies": {
    "@remotion/cli": "4.0.332",
    "@remotion/google-fonts": "4.0.332",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.332"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
